# Public canonical URLs (never put credentials in either value)
CHATGPT_MCP_RESOURCE_URL=https://health.pui-pui.org/mcp
CHATGPT_MCP_AUTHORIZATION_SERVER=https://YOUR_AUTH_DOMAIN/

# OAuth access-token validation
CHATGPT_MCP_ISSUER=https://YOUR_AUTH_DOMAIN/
CHATGPT_MCP_AUDIENCE=https://health.pui-pui.org/api/mcp
CHATGPT_MCP_JWKS_URI=https://YOUR_AUTH_DOMAIN/.well-known/jwks.json
# Exact Auth0 access-token `sub` for the sole allowed account.
CHATGPT_MCP_ALLOWED_SUBJECT=

# Generate independently with a cryptographically secure password manager.
# Never commit the real values.
CHATGPT_MCP_OWNER_HMAC_SECRET=
CHATGPT_MCP_INGEST_HMAC_SECRET=

# Private server-side services. Public Vercel previews remain locked without them.
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
# Exact comma-separated hosts used by ChatGPT attachment download URLs.
CHATGPT_MCP_ATTACHMENT_HOSTS=

# Family website login. Use a separate Auth0 Regular Web Application.
AUTH0_WEB_ISSUER=https://YOUR_AUTH_DOMAIN/
AUTH0_WEB_CLIENT_ID=
AUTH0_WEB_CLIENT_SECRET=
AUTH0_WEB_BASE_URL=https://YOUR_PREVIEW_DOMAIN/
# Invitation allowlist. Add a family member only after they agree to use the service.
AUTH0_WEB_ALLOWED_EMAILS=marco@pui-pui.org
AUTH0_WEB_ADMIN_EMAIL=marco@pui-pui.org

# Generate these independently; use at least 32 random characters for each value.
WEB_SESSION_SECRET=
AUTH0_WEB_OWNER_HMAC_SECRET=
SHORTCUT_TOKEN_SECRET=

# Optional one-time mapping that preserves Marco's existing private records.
# Configure both values together; never change the owner ID after migration.
AUTH0_WEB_LEGACY_OWNER_EMAIL=marco@pui-pui.org
AUTH0_WEB_LEGACY_OWNER_ID=

# Legacy iPhone Shortcut fallback. Keep only until Marco has moved to a
# per-member credential created from the signed-in Dashboard.
SHORTCUT_ACCESS_TOKEN=
SHORTCUT_OWNER_ID=
